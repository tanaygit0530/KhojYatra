{
  "name": "khojyatra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend",
    "shared/ui",
    "shared/types"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "check:security": "node ./scripts/check-security.js",
    "seed": "npm run seed --workspace=backend",
    "demo:script": "npm run demo:script --workspace=backend",
    "test": "npm test --workspace=backend",
    "verify:deploy": "node scripts/verify-deployment.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
